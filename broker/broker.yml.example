# Teragucci Connection Broker - Machine Configuration
#
# Copy to /etc/teragucci/broker.yml and edit for your environment.
# Each machine entry corresponds to a Teragucci server in the pool.

machines:
  - name: dxs-flame-01
    host: 10.10.0.11
    port: 4443
    pool: floating
    gpu: "NVIDIA RTX A4000"
    priority: 10
    tags: [flame, gpu]

  - name: dxs-flame-02
    host: 10.10.0.12
