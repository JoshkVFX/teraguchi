# Teraguchi Connection Broker - Machine Configuration
#
# Copy to /etc/teraguchi/broker.yml and edit for your environment.

machines:
  - name: dxs-flame-01
    host: 10.10.0.11
    port: 4443
    gpu: "NVIDIA RTX 5000 Ada (32 GB)"
    priority: 10
    tags: [flame, ada]

  - name: dxs-flame-02
